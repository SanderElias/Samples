{
  "name": "samples",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">26.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build.samples": "wireit",
    "build.deploy": "wireit",
    "build.lib": "wireit",
    "build.lib.let": "wireit",
    "build.lib.observable-hooks": "wireit",
    "build.lib.observable-utils": "wireit",
    "build.lib.swapi": "wireit",
    "deploy.local": "wireit",
    "e2e": "ng e2e",
    "lint": "ng lint",
    "ng": "ng",
    "server.dev": "cd projects/folderCrud && tsc-watch --onSuccess 'node --experimental-vm-modules ../../dist/folderCrud'",
    "serveHtml": "light-server -s ./ -w '*' --port 8888",
    "start": "wireit",
    "start.slido": "wireit",
    "start.lazy": "wireit",
    "test": "ng test",
    "ntest": "wireit",
    "serve:ssr:slido": "wireit",
    "publish.libs": "node scripts/bump-and-publish.mjs"
  },
  "wireit": {
    "start": {
      "command": "ng serve samples --port 4204 --host 0.0.0.0",
      "service": true,
      "files": [
        "tsconfig.app.json",
        "angular.json"
      ],
      "dependencies": [
        "build.lib"
      ]
    },
    "jsonServer": {
      "command": "json-server --watch db.json --port 3003",
      "service": true
    },
    "start.slido": {
      "command": "ng serve slido --ssl --port 4242",
      "service": true,
      "files": [
        "angular.json",
        "presentations/assets"
      ],
      "dependencies": [
        "build.lib"
      ]
    },
    "start.lazy": {
      "command": "ng serve extremeLazyTest --port 4205",
      "service": true,
      "files": [
        "projects/extreme-lazy-test/**",
        "angular.json"
      ],
      "dependencies": [
        "build.lib"
      ]
    },
    "ntest": {
      "command": "node --test  out-tsc/spec/utils/signals/async-computed.spec.js",
      "files": [
        "src/utils/signals/**"
      ],
      "dependencies": [
        "compileTest"
      ]
    },
    "compileTest": {
      "command": "ngc --project src/tsconfig.spec.json",
      "files": [
        "src/signals/**"
      ],
      "dependencies": [
        "build.lib"
      ]
    },
    "build.deploy": {
      "command": "echo 'Deploying to production'",
      "dependencies": [
        "update.security-txt",
        "build.samples"
      ]
    },
    "update.security-txt": {
      "command": "node scripts/update-security-txt.ts",
      "files": [
        "scripts/update-security-txt.ts"
      ],
      "output": [
        "src/.well-known/security.txt"
      ]
    },
    "build.samples": {
      "command": "ng build --configuration production",
      "files": [
        "src/**",
        "tsconfig.app.json"
      ],
      "output": [
        "dist/samples"
      ],
      "dependencies": [
        "build.lib"
      ]
    },
    "build.slido": {
      "command": "ng build slido --configuration production",
      "files": [
        "projects/slido/src/**",
        "tsconfig.app.json"
      ],
      "output": [
        "dist/slido"
      ],
      "dependencies": [
        "build.lib"
      ]
    },
    "build.simpleInjector": {
      "command": "ng build simpleInjector --configuration production",
      "files": [
        "projects/simple-injector/src/*",
        "projects/simple-injector/tsconfig.lib.json"
      ],
      "output": [
        "dist/se-ng/simple-injector"
      ]
    },
    "build.lib": {
      "dependencies": [
        "build.lib.observable-hooks",
        "build.lib.swapi",
        "build.lib.observable-utils",
        "build.lib.let",
        "build.lib.signalUtils",
        "build.lib.headless",
        "build.simpleInjector",
        "build.lib.blogList"
      ]
    },
    "build.lib.blogList": {
      "command": "node scripts/blogScan.ts",
      "files": [
        "articles/*.md"
      ],
      "clean": false
    },
    "build.lib.let": {
      "command": "ng build @se-ng/let --configuration production",
      "files": [
        "projects/se-ng/let/src/",
        "projects/se-ng/let/tsconfig.lib.json",
        "package.json"
      ],
      "output": [
        "dist/se-ng/let"
      ]
    },
    "build.lib.headless": {
      "command": "ng build @se-ng/headless-ui --configuration production",
      "files": [
        "projects/se-ng/headless-ui/src/",
        "projects/se-ng/headless-ui/tsconfig.lib.json",
        "package.json"
      ],
      "output": [
        "dist/se-ng/headless-ui"
      ],
      "dependencies": [
        "build.lib.signalUtils"
      ]
    },
    "build.lib.observable-hooks": {
      "command": "ng build @se-ng/observable-hooks --configuration production",
      "files": [
        "projects/se-ng/observable-hooks/src/*",
        "projects/se-ng/observable-hooks/tsconfig.lib.json",
        "package.json"
      ],
      "output": [
        "dist/se-ng/observable-hooks"
      ]
    },
    "build.lib.observable-utils": {
      "command": "ng build @se-ng/observable-utils --configuration production",
      "files": [
        "projects/se-ng/observable-utils/src/*",
        "projects/se-ng/observable-utils/tsconfig.lib.json",
        "package.json"
      ],
      "output": [
        "dist/se-ng/observable-utils"
      ]
    },
    "build.lib.swapi": {
      "command": "ng build @se-ng/swapi --configuration production",
      "files": [
        "projects/se-ng/swapi/src/*",
        "projects/se-ng/swapi/tsconfig.lib.json",
        "package.json"
      ],
      "output": [
        "dist/se-ng/swapi"
      ]
    },
    "build.lib.signalUtils": {
      "command": "ng build @se-ng/signalUtils --configuration production",
      "files": [
        "projects/se-ng/signal-utils/src/",
        "projects/se-ng/signal-utils/tsconfig.lib.json",
        "package.json"
      ],
      "output": [
        "dist/se-ng/signal-utils"
      ]
    },
    "deploy.local": {
      "command": "rm -rf /home/sander/media/oldhome/Documents/docker/caddy/site/samples/* && mkdir -p /home/sander/media/oldhome/Documents/docker/caddy/site/samples && cp -r dist/samples/browser/. /home/sander/media/oldhome/Documents/docker/caddy/site/samples/",
      "dependencies": [
        "build.deploy"
      ]
    },
    "serve:ssr:slido": {
      "command": "node dist/slido/server/server.mjs",
      "dependencies": [
        "build.slido"
      ]
    }
  },
  "dependencies": {
    "@angular/animations": "22.1.3",
    "@angular/aria": "22.1.3",
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.3",
